(executable
 (name bt)
 (libraries lang series data engine metrics report broker intraday))

(rule
 (target version.ml)
 (deps ../dune-project (universe) (sandbox none))
 (action
  (with-stdout-to %{target}
   (run sh -c
    "version=$(sed -n 's/^(version \\(.*\\))$/\\1/p' %{dep:../dune-project});
     [ -n \"$version\" ] || { echo 'dune-project has no (version ...) line' >&2; exit 1; };
     head=$(git rev-parse HEAD 2>/dev/null || true);
     sha=$(git rev-parse --short HEAD 2>/dev/null || true);
     release=$(git rev-parse -q --verify \"refs/tags/v$version^{commit}\" 2>/dev/null || true);
     unprefixed=$(git rev-parse -q --verify \"refs/tags/$version^{commit}\" 2>/dev/null || true);
     if [ -n \"$sha\" ] && [ \"$head\" != \"$release\" ] && [ \"$head\" != \"$unprefixed\" ]; then version=\"$version+$sha\"; fi;
     printf 'let version = \"%s\"\\n' \"$version\""))))
